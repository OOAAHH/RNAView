gsave Al 75.14 165.05 moveto (5') center show grestore
/Times findfont 11 scalefont setfont
/center{dup stringwidth pop 2 div neg 0 rmoveto } bind def
gsave Al -4.06 -13.14 moveto (3') center show grestore
Il 71.08 159.91 59.23 133.26 LINE
 Il 59.23 133.26 47.39 106.61 LINE
 Il 47.39 106.61 35.54 79.96 LINE
 Il 35.54 79.96 23.69 53.30 LINE
 Il 23.69 53.30 11.85 26.65 LINE
 Il 11.85 26.65 0.00 0.00 LINE
 /Times findfont 11 scalefont setfont
/center{dup stringwidth pop 2 div neg 0 rmoveto } bind def
gsave Al 65.94 -13.14 moveto (5') center show grestore
/Times findfont 11 scalefont setfont
/center{dup stringwidth pop 2 div neg 0 rmoveto } bind def
gsave Al 145.14 165.05 moveto (3') center show grestore
Tl 70.00 0.00 81.85 26.65 LINE
